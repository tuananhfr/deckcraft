<?xml version="1.0" encoding="utf-8"?>
<!--
  Trình chiếu – ERPCons MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build deckcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.deckcraft` owned by
  Trình chiếu – ERPCons, and Trình chiếu – ERPCons offered under "Open with" for .pptx/.potx/.ppsx (without taking over
  the user's default app for them).

  UpgradeCode belongs to the ERPCons product; keep it fixed for future upgrades.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Trình chiếu – ERPCons"
      Manufacturer="ERPCons"
      Version="$(var.Version)"
      UpgradeCode="88ECA095-071A-4037-BC70-6E1E8D01451D"
      Scope="perMachine"
      Compressed="yes"
      Language="1033"
      Codepage="65001">
    <SummaryInformation Codepage="1252" Description="ERPCons TrinhChieu presentations" Manufacturer="ERPCons" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Trình chiếu – ERPCons is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeckcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeckcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://office.erpcons.ai" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/tuananhfr/deckcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tuananhfr/deckcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="ERPConsFolder" Name="ERPCons">
        <Directory Id="INSTALLFOLDER" Name="TrinhChieu" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Trình chiếu – ERPCons" Level="1">
      <ComponentGroupRef Id="DeckcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DeckcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DeckcraftApp" Guid="8F8F8A39-DB0E-426E-AB7D-775A5E79B93F">
        <File Id="DeckcraftExe" Source="$(var.BinDir)\deckcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Trình chiếu – ERPCons"
              Description="Trình chiếu – ERPCons presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DeckcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .deckcraft: Trình chiếu – ERPCons's own format. -->
        <ProgId Id="ERPCons.TrinhChieu.deckcraft" Description="Trình chiếu – ERPCons Presentation" Icon="DeckcraftExe" IconIndex="0">
          <Extension Id="deckcraft" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Open" TargetFile="DeckcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- Settings > Default apps: lets the user pick Trình chiếu – ERPCons for these types. -->
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities" Name="ApplicationName" Value="Trình chiếu – ERPCons" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities" Name="ApplicationDescription" Value="Create and edit presentations and slide shows." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities" Name="ApplicationIcon" Value="&quot;[#DeckcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities\FileAssociations" Name=".deckcraft" Value="ERPCons.TrinhChieu.deckcraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities\FileAssociations" Name=".pptx" Value="ERPCons.TrinhChieu.pptx" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities\FileAssociations" Name=".potx" Value="ERPCons.TrinhChieu.potx" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\ERPCons\TrinhChieu\Capabilities\FileAssociations" Name=".ppsx" Value="ERPCons.TrinhChieu.ppsx" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Trình chiếu – ERPCons" Value="Software\ERPCons\TrinhChieu\Capabilities" Type="string" />

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe" Name="FriendlyAppName" Value="Trình chiếu – ERPCons" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\deckcraft.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.pptx" Value="Trình chiếu – ERPCons Presentation" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.pptx\DefaultIcon" Value="&quot;[#DeckcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.pptx\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="ERPCons.TrinhChieu.pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.potx" Value="Trình chiếu – ERPCons Presentation" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.potx\DefaultIcon" Value="&quot;[#DeckcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.potx\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="ERPCons.TrinhChieu.potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.ppsx" Value="Trình chiếu – ERPCons Presentation" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.ppsx\DefaultIcon" Value="&quot;[#DeckcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ERPCons.TrinhChieu.ppsx\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="ERPCons.TrinhChieu.ppsx" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\deckcraft.exe" Value="[#DeckcraftExe]" Type="string" />
      </Component>

      <!-- No deckcraft-cli.exe: it would edit documents without the PI licence gate. The major
           upgrade removes the copy that earlier MSIs installed. -->
    </ComponentGroup>
  </Fragment>
</Wix>
